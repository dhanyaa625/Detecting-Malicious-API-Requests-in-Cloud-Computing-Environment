# Copy this file to `.env` (in the project root) and fill in your real values.
# `.env` is gitignored -- it will never be committed.

# Which LLM provider to try first: "groq" (default) or "ollama".
# The other is tried automatically as a fallback if the first fails.
LLM_PROVIDER=groq

# Groq (cloud, free tier) -- get a key from https://console.groq.com/keys
GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (local, no key needed) -- install from https://ollama.com,
# then `ollama pull llama3.2` before running the app.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
